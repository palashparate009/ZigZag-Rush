rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read, create, update: if request.auth != null
                                  && request.auth.uid == playerId;
      allow delete: if request.auth != null && request.auth.uid == playerId;
    }

    function validLeaderboardBoard(boardId) {
      return boardId.matches('^(all_time|daily_[0-9]{8}|weekly_[0-9]{8})$');
    }

    function validLeaderboardScore() {
      return request.resource.data.keys().hasAll(['name', 'score', 'updated_at'])
             && request.resource.data.keys().hasOnly(['name', 'score', 'updated_at'])
             && request.resource.data.name is string
             && request.resource.data.name.size() > 0
             && request.resource.data.name.size() <= 32
             && request.resource.data.score is int
             && request.resource.data.score > 0
             && request.resource.data.score <= 1000000
             && request.resource.data.updated_at is timestamp;
    }

    match /leaderboards/{boardId}/scores/{playerId} {
      allow read: if request.auth != null && validLeaderboardBoard(boardId);
      allow create: if request.auth != null
                    && request.auth.uid == playerId
                    && validLeaderboardBoard(boardId)
                    && validLeaderboardScore();
      allow update: if request.auth != null
                    && request.auth.uid == playerId
                    && validLeaderboardBoard(boardId)
                    && validLeaderboardScore()
                    && request.resource.data.score >= resource.data.score;
      allow delete: if request.auth != null && request.auth.uid == playerId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
